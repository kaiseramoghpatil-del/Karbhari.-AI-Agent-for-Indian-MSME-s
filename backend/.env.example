# Google AI Studio (Gemini) API key for KARBHARI's investigator agent.
# Free tier key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# LLM provider selection -- see backend/app/llm/factory.py. Only "gemini"
# is implemented today.
LLM_PROVIDER=gemini

# Model alias, not a pinned version -- aliases track Google's current
# recommended model automatically as specific versions get deprecated.
LLM_MODEL=gemini-flash-lite-latest

# Comma-separated list of allowed CORS origins for the frontend.
# Useful if the frontend is hosted separately from the FastAPI backend.
# KARBHARI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
